  {"id":110,"content":"早安！愿你：有事做，有人爱，有所期待。今天也是元气满满的一天！","author":"佚名","source":"早安语录","scenes":["早安晚安","朋友圈","励志"],"type":"paragraph","wordCount":30,"likes":7890,"createdAt":"2026-03-31T06:45:00Z","gradientIndex":4,"isHot":false}
